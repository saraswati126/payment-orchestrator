{
  "Comment": "Enterprise Serverless Payment Orchestrator Transaction Workflow State Machine",
  "StartAt": "ValidatePaymentState",
  "States": {
    "ValidatePaymentState": {
      "Type": "Task",
      "Resource": "${ValidatePaymentLambdaArn}",
      "Next": "IsPayloadValidChoice"
    },
    "IsPayloadValidChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.isValid",
          "BooleanEquals": true,
          "Next": "AuthorizePaymentState"
        }
      ],
      "Default": "TransactionFailedState"
    },
    "AuthorizePaymentState": {
      "Type": "Task",
      "Resource": "${AuthorizePaymentLambdaArn}",
      "ResultPath": "$.authResult",
      "Next": "IsAuthorizationSuccessfulChoice"
    },
    "IsAuthorizationSuccessfulChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.authResult.status",
          "StringEquals": "AUTHORIZED",
          "Next": "PrepareCapturePayloadState"
        }
      ],
      "Default": "TransactionFailedState"
    },
    "PrepareCapturePayloadState": {
      "Type": "Pass",
      "Parameters": {
        "transactionId.$": "$.authResult.transactionId",
        "amount.$": "$.amount",
        "currency.$": "$.currency"
      },
      "Next": "CapturePaymentState"
    },
    "CapturePaymentState": {
      "Type": "Task",
      "Resource": "${CapturePaymentLambdaArn}",
      "ResultPath": "$.captureResult",
      "Next": "TransactionSuccessState"
    },
    "TransactionSuccessState": {
      "Type": "Succeed"
    },
    "TransactionFailedState": {
      "Type": "Fail",
      "Cause": "Payment Processing Pipeline Failure Condition Reached.",
      "Error": "PAYMENT_ORCHESTRATION_ERROR"
    }
  }
}